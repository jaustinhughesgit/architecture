{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.1var.com/contracts/canonical-governance.v1.schema.json",
  "title": "1var canonical governance contract v1",
  "oneOf": [
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/lifecycleTransition" },
    { "$ref": "#/$defs/auditEvent" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "action": { "enum": ["find", "read", "aggregate", "use", "execute", "set", "edit", "delete", "delegate", "publish", "govern"] },
    "state": { "enum": ["draft", "active", "deprecated", "revoked", "deleted"] },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "recordType", "resourceId", "actorId", "action", "allowed", "code"],
      "properties": {
        "contractVersion": { "const": 1 }, "recordType": { "const": "governance-decision" },
        "resourceId": { "$ref": "#/$defs/id" }, "actorId": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/action" }, "allowed": { "type": "boolean" },
        "code": { "$ref": "#/$defs/id" }, "source": { "enum": ["owner", "grant", "public", "compatibility", "none"] },
        "currentVersion": { "type": "integer", "minimum": 1 },
        "grantId": { "type": ["string", "null"], "maxLength": 180 }
      }
    },
    "lifecycleTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "recordType", "resourceType", "resourceId", "expectedVersion", "nextVersion", "fromState", "toState", "tombstone"],
      "properties": {
        "contractVersion": { "const": 1 }, "recordType": { "const": "lifecycle-transition" },
        "resourceType": { "enum": ["word", "entity", "address", "group", "relation", "grant", "capability", "installation", "protected-asset"] },
        "resourceId": { "$ref": "#/$defs/id" }, "expectedVersion": { "type": "integer", "minimum": 1 },
        "nextVersion": { "type": "integer", "minimum": 2 }, "fromState": { "$ref": "#/$defs/state" },
        "toState": { "$ref": "#/$defs/state" }, "tombstone": { "type": "boolean" }, "requestId": { "$ref": "#/$defs/id" },
        "lifecycle": { "type": "object" }, "decision": { "$ref": "#/$defs/decision" }, "auditEventId": { "$ref": "#/$defs/id" }
      }
    },
    "auditEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "eventId", "timestamp", "resourceType", "resourceId", "actorId", "action", "allowed", "decisionCode"],
      "properties": {
        "schemaVersion": { "const": 1 }, "recordType": { "const": "governance-audit" },
        "eventId": { "$ref": "#/$defs/id" }, "timestamp": { "type": "string", "format": "date-time" },
        "resourceType": { "type": "string", "minLength": 1, "maxLength": 80 }, "resourceId": { "$ref": "#/$defs/id" },
        "actorId": { "$ref": "#/$defs/id" }, "action": { "$ref": "#/$defs/action" },
        "allowed": { "type": "boolean" }, "decisionCode": { "$ref": "#/$defs/id" },
        "requestId": { "type": ["string", "null"], "maxLength": 180 },
        "metadata": { "type": "object", "maxProperties": 12, "additionalProperties": { "type": "string", "maxLength": 180 } }
      }
    }
  }
}
